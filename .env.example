# ─────────────────────────────────────────────────────────────
#  SoapBase.pk — environment variables
#  Copy this file to `.env` and fill in your Supabase credentials,
#  then run:  npm install && npm run setup
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Example: postgresql://postgres.abcdefghijkl:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Keep this secret (server only). Used to upload/delete product & category images.
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket for images (created automatically by `npm run setup`)
SUPABASE_STORAGE_BUCKET=soapbase-images

# Admin panel login (/admin). TEMPORARY credentials — change before going live!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Secret used to sign admin sessions. `npm run setup` generates one if it is empty.
ADMIN_SESSION_SECRET=
